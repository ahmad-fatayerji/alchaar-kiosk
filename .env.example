# --- Database (compose.prod uses these if DATABASE_URL not set) ---
POSTGRES_DB=kiosk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Alternatively, provide a full URL (overrides above)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/kiosk?schema=public

# --- Next.js ---
NODE_ENV=production
# Set to true to hide prices in kiosk
NEXT_PUBLIC_HIDE_PRICES=false
# Disable sales in kiosk
NEXT_PUBLIC_SALES_ENABLED=true
# Hide stock level filters
NEXT_PUBLIC_HIDE_STOCK=false
# Admin password for /admin (example only; change in your .env)
NEXT_PUBLIC_ADMIN_PASS=admin

# --- App-specific ---
# Add any secrets or configuration the app reads (e.g., JWT secret, kiosk settings)

# --- Container image (optional) ---
# If you push an image to a registry, set the image name:tag below and compose.prod will use it
# APP_IMAGE=ghcr.io/youruser/alchaar-kiosk:latest
